.DS_Store
.gradle/
.idea/
.kotlin/
build/
local.properties

# Release-Signing: NIEMALS committen (Keystore + Klartext-Passwort).
*.jks
*.keystore
keystore.properties

# Persönliche Notizen mit Zugangsdaten — gehören nur auf den eigenen Rechner.
Gitignore - wichtige Passw*

# .claude/ ist lokal (Settings), aber die Skills sind versionierte Anweisungen — die bleiben
# bewusst getrackt, damit Claude Code und Hermes Agent dieselbe Quelle lesen.
/.claude/*
!/.claude/skills/
!/.claude/hooks/
!/.claude/settings.json

# Projektlokale Hermes-Skills (Symlink auf .claude/skills — nur lokal)
/.hermes/
